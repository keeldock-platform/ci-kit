{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keeldock:kd-ci:user-config:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "color": {
      "enum": [
        "auto",
        "never"
      ]
    },
    "progress": {
      "type": "boolean"
    },
    "retention_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    }
  }
}
